{
  "name": "openharmony-debug-test-pipeline",
  "version": "0.1.0",
  "description": "OpenHarmony 修改-调试-测试闭环 DSH 插件：聚合分诊/修复/MR/CI/OTA/回归六个 skill 模块与八阶段编排，各模块可独立调用",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/link-runtime-dsh-tools.mjs",
    "link-runtime-deps": "node scripts/link-runtime-dsh-tools.mjs",
    "build": "rm -rf lib && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s skills/openharmony-ci-orchestrator/tests -v && python3 -m unittest discover -s skills/glab-mr-submit/tests -v"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "schemastery": "^3.18.0"
  },
  "vendored": {
    "@deepseek-ai/dsh-tools": "runtime tree"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
